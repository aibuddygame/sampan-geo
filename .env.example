# Optional local settings. No credentials are needed for P01-1.
SAMPAN_ENVIRONMENT=local
SAMPAN_DEBUG=false
# Optional server-side Kimi keyword analysis. Never place a real key here.
SAMPAN_KIMI_API_KEY=
SAMPAN_KIMI_MODEL=kimi-k3.1-pro

# Optional. Set a unique password privately to enable the loopback marksix-gold client preview.
SAMPAN_MARKSIX_PORTAL_PASSWORD=
